# ==========================================
# .gitignore for Lume
# ==========================================

# 1. Local Test Books & Output Directories (Never commit books or generated e-books)
books_test/
book_test/
Restored_Output/
workdir/
marker_input/
comparison_assets/
*.pdf
*.epub
*.azw3
*.jpg
*.jpeg
*.png
*.log
process_log.txt
restoration_report.json
comparison_report.html

# 2. Python Bytecode & Test/Lint Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 3. Virtual Environments
venv/
.venv/
env/

# 4. OS & Temporary Files
.DS_Store
Thumbs.db
Desktop.ini

# 5. IDE Settings
.vscode/
.idea/
